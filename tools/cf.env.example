# Cấu hình Cloudflare cho tool tạo khách (make-customer.mjs)
# → Copy file này thành  cf.env  (cùng thư mục) rồi điền token thật.
# KHÔNG chia sẻ / KHÔNG commit file cf.env (đã .gitignore).

# Token tạo tại: dash.cloudflare.com → My Profile → API Tokens → Create Custom Token
# Quyền cần: Account > Cloudflare Tunnel: Edit  |  Zone > DNS: Edit  |  Zone > Zone: Read
# Zone Resources: chọn đúng maychamcongcloud.com
CF_API_TOKEN=dan_token_vao_day

# Domain gốc để tạo subdomain khách (mỗi khách = <tencty>.<ZONE>)
ZONE=maychamcongcloud.com

# (Tuỳ chọn) Bỏ trống thì tool tự lấy account đầu tiên
CF_ACCOUNT_ID=
